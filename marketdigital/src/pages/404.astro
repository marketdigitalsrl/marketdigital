---
import Base from '../layouts/Base.astro';
---
<Base title="Pagina non trovata">
  <section class="section">
    <div class="wrap" style="display:grid;gap:1.5rem;justify-items:start">
      <h1>Questa pagina non esiste</h1>
      <p class="lead">Il link potrebbe essere sbagliato o la pagina è stata spostata.</p>
      <a class="btn btn-primary" href="/">Torna alla home</a>
    </div>
  </section>
</Base>
