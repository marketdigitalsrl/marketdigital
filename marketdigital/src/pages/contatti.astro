---
import Base from '../layouts/Base.astro';
import sito from '../data/sito.json';
const mail = `mailto:${sito.email}?subject=${encodeURIComponent('Richiesta consulenza dal sito')}`;
---
<Base title="Contatti" description="Contatta Market Digital per una consulenza di marketing online.">
  <header class="page-head">
    <div class="wrap">
      <h1>Contatti</h1>
      <p>Raccontaci la tua attività e cosa vorresti ottenere online. Ti rispondiamo via email.</p>
    </div>
  </header>
  <section class="section">
    <div class="wrap contatto">
      <a class="mail" href={mail}>{sito.email}</a>
      <p class="hint">Più dettagli ci dai (settore, obiettivi, cosa fai già online), più precisa sarà la nostra risposta.</p>
      <a class="btn btn-primary" href={mail}>Scrivi un’email</a>
      {sito.indirizzo && (
        <div class="dove">
          <h2>Dove siamo</h2>
          <p>{sito.indirizzo}</p>
        </div>
      )}
    </div>
  </section>
</Base>
<style>
  .contatto { display: grid; gap: 1.5rem; justify-items: start; }
  .mail { font-family: var(--display); font-weight: 700; font-size: clamp(1.5rem, 4.5vw, 3rem); letter-spacing: -0.02em; color: var(--cobalt); text-decoration: none; overflow-wrap: anywhere; line-height: 1.15; }
  .mail:hover { text-decoration: underline; text-underline-offset: 6px; text-decoration-thickness: 3px; }
  .hint { color: var(--muted); max-width: 36rem; font-size: 1.1rem; }
  .dove { margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--line); width: 100%; display: grid; gap: .5rem; }
  .dove h2 { font-size: 1.6rem; }
  .dove p { color: var(--muted); font-size: 1.15rem; }
</style>
